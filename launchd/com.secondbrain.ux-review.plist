<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.secondbrain.ux-review</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__ROOT__/bin/ux-review.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>__ROOT__/logs/launchd-ux-review.log</string>
	<key>StandardOutPath</key>
	<string>__ROOT__/logs/launchd-ux-review.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>16</integer>
		<key>Minute</key>
		<integer>0</integer>
		<key>Weekday</key>
		<integer>5</integer>
	</dict>
</dict>
</plist>
