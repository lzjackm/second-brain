<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.secondbrain.distill</string>
	<key>ProgramArguments</key>
	<array>
		<string>__ROOT__/bin/distill.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>__ROOT__/logs/launchd-distill.log</string>
	<key>StandardOutPath</key>
	<string>__ROOT__/logs/launchd-distill.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>12</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
</dict>
</plist>
